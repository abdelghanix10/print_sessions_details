<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Individual POS Config Form View -->
    <record id="pos_config_view_form_inherit_session_details" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.session.details</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Session Details on Login Screen" name="session_details_section">
                    <group>
                        <field name="enable_session_details"/>
                        <field name="psd_allow_session_navigation" invisible="not enable_session_details"/>
                    </group>
                    <group invisible="not enable_session_details">
                        <field name="psd_show_cashier"/>
                        <field name="psd_show_total_sales"/>
                        <field name="psd_show_cash_diff"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Global POS Settings View (Point of Sale -> Configuration -> Settings) -->
    <record id="res_config_settings_view_form_inherit_session_details" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.session.details</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="Session Details on Login Screen"
                         help="Display closed session info and print buttons on the POS login screen">
                    <field name="pos_enable_session_details"/>
                    <div class="content-group mt16" invisible="not pos_enable_session_details">
                        <div class="row">
                            <label for="pos_psd_allow_session_navigation" class="col-lg-6 o_light_label"/>
                            <field name="pos_psd_allow_session_navigation"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_psd_show_cashier" class="col-lg-6 o_light_label"/>
                            <field name="pos_psd_show_cashier"/>
                        </div>
                        <div class="row">
                            <label for="pos_psd_show_total_sales" class="col-lg-6 o_light_label"/>
                            <field name="pos_psd_show_total_sales"/>
                        </div>
                        <div class="row">
                            <label for="pos_psd_show_cash_diff" class="col-lg-6 o_light_label"/>
                            <field name="pos_psd_show_cash_diff"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>