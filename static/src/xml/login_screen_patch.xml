<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="print_sessions_details.LoginScreen"
       t-inherit="point_of_sale.LoginScreen"
       t-inherit-mode="extension">

        <!-- ① Session details card inside .login-body -->
        <xpath expr="//div[hasclass('login-body')]" position="inside">
            <t t-if="this.showSessionDetailsBlock">
                <div class="psd-session-card">
                    <div class="psd-header d-flex justify-content-between align-items-center mb-2">
                        <button t-if="this.psdSettings.psd_allow_session_navigation and this.sessionDetails.history.length &gt; 1"
                                class="psd-nav-btn btn btn-sm btn-light border-0"
                                title="Older Closed Session"
                                t-att-disabled="!this.canGoOlderSession"
                                t-on-click="() => this.olderSession()">
                            <i class="oi" data-icon="chevron_left"/>
                        </button>
                        <div class="psd-title m-0 flex-grow-1 text-center">
                            Session Details
                        </div>
                        <button t-if="this.psdSettings.psd_allow_session_navigation and this.sessionDetails.history.length &gt; 1"
                                class="psd-nav-btn btn btn-sm btn-light border-0"
                                title="Newer Closed Session"
                                t-att-disabled="!this.canGoNewerSession"
                                t-on-click="() => this.newerSession()">
                            <i class="oi" data-icon="chevron_right"/>
                        </button>
                    </div>

                    <t t-if="this.sessionDetails.loading">
                        <div class="psd-loading">
                            <span class="spinner-border spinner-border-sm me-1" role="status"/> Loading…
                        </div>
                    </t>
                    <t t-elif="this.currentSessionItem">
                        <t t-set="item" t-value="this.currentSessionItem"/>

                        <t t-if="this.psdSettings.psd_show_cashier">
                            <div class="psd-row">
                                <span class="psd-label">Session</span>
                                <span class="psd-value" t-out="item.name"/>
                            </div>
                            <div class="psd-row">
                                <span class="psd-label">Cashier</span>
                                <span class="psd-value" t-out="item.cashier"/>
                            </div>
                        </t>

                        <div class="psd-row">
                            <span class="psd-label">Opening Date</span>
                            <span class="psd-value" t-out="item.opening_date"/>
                        </div>
                        <div class="psd-row">
                            <span class="psd-label">Closing Date</span>
                            <span class="psd-value" t-out="item.closing_date"/>
                        </div>

                        <t t-if="this.psdSettings.psd_show_total_sales">
                            <div class="psd-row">
                                <span class="psd-label">Orders</span>
                                <span class="psd-value" t-out="item.order_count"/>
                            </div>
                            <div class="psd-row">
                                <span class="psd-label">Total Sales</span>
                                <span class="psd-value text-primary" t-out="item.total_sales"/>
                            </div>
                        </t>

                        <t t-if="this.psdSettings.psd_show_cash_diff">
                            <div class="psd-row">
                                <span class="psd-label">Opening Cash</span>
                                <span class="psd-value" t-out="item.opening_balance"/>
                            </div>
                            <div class="psd-row">
                                <span class="psd-label">Cash Diff</span>
                                <span t-att-class="'psd-value ' + (item.has_negative_diff ? 'text-danger' : 'text-success')"
                                      t-out="item.cash_difference"/>
                            </div>
                        </t>

                        <div class="psd-row">
                            <span class="psd-label">Ending Balance</span>
                            <span class="psd-value psd-balance" t-out="item.ending_balance"/>
                        </div>

                        <div class="psd-card-actions d-flex flex-column justify-content-between gap-2 mt-3 pt-2 border-top">
                            <button class="psd-btn-print btn btn-dark btn-sm flex-fill"
                                    t-on-click="() => this.printSessionSummary()">
                                <i class="oi" data-icon="print"/>
                                <span>Print</span>
                            </button>
                            <button class="psd-btn-print-details btn btn-dark btn-sm flex-fill"
                                    t-on-click="() => this.printSessionDetails()">
                                <i class="oi" data-icon="description"/>
                                <span>Print Details</span>
                            </button>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>

    </t>
</templates>